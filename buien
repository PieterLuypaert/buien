def fetch_json(url):
    """The decoded JSON at url, or None when the server answers 404."""
    data = fetch_bytes(url)
    if data is None:
        return None
    try:
        return json.loads(data)
    except ValueError as error:
        raise BuienError(f"no usable answer from {urllib.parse.urlsplit(url).hostname} ({error!r})") from error


def fetch_bytes(url):
    """What the server sends for url, or None when it answers 404."""
    host = urllib.parse.urlsplit(url).hostname
    request = urllib.request.Request(url, headers={"User-Agent": f"buien/{__version__} (+{REPO_URL})"})
    try:
        with urllib.request.urlopen(request, timeout=10) as response:
            return response.read()
    except urllib.error.HTTPError as error:
        if error.code == 404:
            return None
        raise BuienError(f"{host} answered with HTTP {error.code}") from error
    except urllib.error.URLError as error:
        raise BuienError(f"{host} is unreachable ({error.reason})") from error
    except (OSError, ValueError, http.client.HTTPException) as error:
        raise BuienError(f"no usable answer from {host} ({error!r})") from error


PNG_SIGNATURE = b"\x89PNG\r\n\x1a\n"
Picture = namedtuple("Picture", "width height rows channels")


def decode_png(data):
    """The rows of bytes of an 8-bit RGB or RGBA PNG without interlacing, the kind Buienradar sends."""
    if not data.startswith(PNG_SIGNATURE):
        raise BuienError("Buienradar sent a radar image that is not a PNG")
    header, compressed, position = None, bytearray(), len(PNG_SIGNATURE)
    while position + 8 <= len(data):
        length, kind = struct.unpack(">I4s", data[position:position + 8])
        body = data[position + 8:position + 8 + length]
        if kind == b"IHDR" and len(body) == 13:
            header = struct.unpack(">IIBBBBB", body)
        elif kind == b"IDAT":
            compressed += body
        position += 12 + length
    if header is None or header[2] != 8 or header[3] not in (2, 6) or header[6]:
        raise BuienError("Buienradar sent a radar image buien cannot read")
    width, height, channels = header[0], header[1], 4 if header[3] == 6 else 3
    try:
        raw = zlib.decompress(bytes(compressed))
    except zlib.error as error:
        raise BuienError(f"Buienradar sent a broken radar image ({error})") from error
    return Picture(width, height, unfilter(raw, width * channels, height, channels), channels)


def unfilter(raw, stride, height, bpp):
    """The rows of a PNG image, each with its filter undone."""
    if len(raw) < (stride + 1) * height:
        raise BuienError("Buienradar sent a radar image that ends too soon")
    rows, prior = [], bytearray(stride)
    for start in range(0, (stride + 1) * height, stride + 1):
        line = bytearray(raw[start + 1:start + 1 + stride])
        undo_filter(raw[start], line, prior, bpp)
        rows.append(line)
        prior = line
    return rows


def undo_filter(kind, line, prior, bpp):
    """Undoes one of PNG's five row filters in place: none, sub, up, average or paeth."""
    if kind == 1:
        for i in range(bpp, len(line)):
            line[i] = (line[i] + line[i - bpp]) & 255
    elif kind == 2:
        for i in range(len(line)):
            line[i] = (line[i] + prior[i]) & 255
    elif kind == 3:
        for i in range(len(line)):
            line[i] = (line[i] + (((line[i - bpp] if i >= bpp else 0) + prior[i]) >> 1)) & 255
    elif kind == 4:
        for i in range(len(line)):
            left, up = (line[i - bpp], prior[i - bpp]) if i >= bpp else (0, 0)
            line[i] = (line[i] + paeth(left, prior[i], up)) & 255
    elif kind:
        raise BuienError(f"Buienradar sent a radar image with an unknown filter ({kind})")


def paeth(left, up, corner):
    estimate = left + up - corner
    to_left, to_up, to_corner = abs(estimate - left), abs(estimate - up), abs(estimate - corner)
    if to_left <= to_up and to_left <= to_corner:
        return left
    return up if to_up <= to_corner else corner


SEA, LAND_DARK, LAND_LIGHT, BORDER = range(4)
MAP_MASK_SIZE = (264, 229)
RADAR_BOUNDS = (49.5, 54.8, 0.0, 10.0)


def shrink_mask(grid, width, height):
    """grid scaled down to width x height: a border wherever one crosses a pixel, else what covers most of it."""
    rows = []
    for top, bottom in spans(len(grid), height):
        row = []
        for left, right in spans(len(grid[0]), width):
            counts = [0, 0, 0, 0]
            for line in grid[top:bottom]:
                for value in line[left:right]:
                    counts[value] += 1
            row.append(BORDER if counts[BORDER] else counts.index(max(counts[:BORDER])))
        rows.append(row)
    return rows


def spans(size, parts):
    """[start, end) of each of parts equal stretches of size, none of them empty."""
    return [(part * size // parts, max(part * size // parts + 1, (part + 1) * size // parts)) for part in range(parts)]


@functools.lru_cache(maxsize=4)
def map_mask(width, height):
    """Sea, land and borders of the radar map at width x height pixels."""
    full_width, full_height = MAP_MASK_SIZE
    packed = zlib.decompress(base64.b64decode(MAP_MASK))
    values = [byte >> shift & 3 for byte in packed for shift in (6, 4, 2, 0)]
    grid = [values[y * full_width:(y + 1) * full_width] for y in range(full_height)]
    return shrink_mask(grid, width, height)


def mercator(lat):
    return math.log(math.tan(math.pi / 4 + math.radians(lat) / 2))


def map_position(place, width, height):
    """The pixel where place lies on the radar map of width x height, or None when it lies off the map."""
    south, north, west, east = RADAR_BOUNDS
    x = int((place.lon - west) / (east - west) * width)
    y = int((mercator(north) - mercator(place.lat)) / (mercator(north) - mercator(south)) * height)
    return (x, y) if 0 <= x < width and 0 <= y < height else None


def lookup(text, choose=False):
    """The place for a name or coordinates; with choose, the one picked from every match."""
    match = COORDS.match(text)
    if match:
        lat, lon = float(match[1]), float(match[2])
        return Place(f"{lat:.2f}, {lon:.2f}", lat, lon)
    if choose:
        return choose_place(find_places(text))
    return to_place(find_places(text)[0])


def find_places(name):
    """Every match for a place name, Belgian and Dutch ones first."""
    results = search_places(name)
    if not results and " " in name:
        results = search_places(name.replace(" ", "-"))
    if not results:
        raise BuienError(f"no place found called '{name}'")
    return sorted(results, key=lambda result: result.get("country_code") not in NEARBY_COUNTRIES)


def to_place(result):
    name, region = result["name"], region_of(result)
    label = f"{name}, {region}" if region and region != name else name
    return Place(label, result["latitude"], result["longitude"])


def region_of(result):
    """The province: admin1 is only the region in Belgium, so there it is admin2."""
    if result.get("country_code") == "BE" and result.get("admin2"):
        return result["admin2"]
    return result.get("admin1")


def choose_place(results):
    """Lists the matches; in a terminal, the one picked, else None."""
    places = [to_place(result) for result in results]
    width = max(len(place.name) for place in places)
    for number, (place, result) in enumerate(zip(places, results), 1):
        print(f"{number:>3}  {place.name.ljust(width)}  {result.get('country', '')}".rstrip())
    if not sys.stdin.isatty():
        return None
    try:
        answer = input(f"Which one? (1-{len(places)}, enter to stop) ").strip()
    except EOFError:
        answer = ""
    if not answer:
        return None
    if not answer.isdigit() or not 1 <= int(answer) <= len(places):
        raise BuienError(f"pick a number from 1 to {len(places)}")
    return places[int(answer) - 1]


def search_places(name):
    query = urllib.parse.urlencode({"name": name, "count": 10, "language": "nl", "format": "json"})
    return (fetch_json(GEOCODE_URL + query) or {}).get("results") or []


def user_dir(variable, default):
    """buien's own folder under an XDG base folder such as XDG_CONFIG_HOME."""
    return Path(os.environ.get(variable) or Path.home() / default) / "buien"


def places_file():
    return user_dir("XDG_CONFIG_HOME", ".config") / "places.json"


def load_places():
    """Saved places by their lowercase name, home among them."""
    path = places_file()
    if not path.exists():
        return {}
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
        return {name: Place(place["name"], float(place["lat"]), float(place["lon"])) for name, place in data.items()}
    except (OSError, ValueError, KeyError, TypeError, AttributeError) as error:
        raise BuienError(f"{path} is unreadable ({error!r}), fix it or remove it and save your places again") from error


def write_places(places):
    data = {name: place._asdict() for name, place in sorted(places.items())}
    write_atomic(places_file(), json.dumps(data, ensure_ascii=False, indent=2) + "\n")


def write_atomic(path, text):
    """Writes through a temporary file, so a write that fails halfway leaves the old file whole."""
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=path.parent, prefix=f".{path.name}.", delete=False)
    try:
        with temporary:
            temporary.write(text)
            temporary.flush()
            os.fsync(temporary.fileno())
        os.replace(temporary.name, path)
    except BaseException:
        os.unlink(temporary.name)
        raise


def save_place(name, place):
    print(remember_place(name, place), file=sys.stderr)
    return place


def remember_place(name, place):
    """Saves place under name and returns the sentence that says so."""
    name = name.lower()
    places = load_places()
    places[name] = place
    write_places(places)
    shortcut = "plain buien" if name == HOME else f"buien {name}"
    return f"{place.name} is saved as {name}, from now on {shortcut} is enough"


def forget_place(name):
    name = name.lower()
    places = load_places()
    if name not in places:
        raise BuienError(f"no saved place called '{name}', see buien --places")
    del places[name]
    write_places(places)
    print(f"forgot {name}", file=sys.stderr)


def print_places(names_only=False):
    places = load_places()
    if not places and not names_only:
        print("no saved places yet, save one with buien --home <place> or buien --save <name> <place>")
        return
    width = max(map(len, places), default=0)
    for name in home_first(places):
        place = places[name]
        print(name if names_only else f"{name.ljust(width)}  {place.name} ({place.lat:.2f}, {place.lon:.2f})")


def home_first(places):
    return sorted(places, key=lambda name: (name != HOME, name))


def matching_places(text):
    """Every place called text, or the one place at text's coordinates."""
    if COORDS.match(text):
        return [lookup(text)]
    return [to_place(result) for result in find_places(text)]


def ask_home():
    if not sys.stdin.isatty():
        raise BuienError("no home saved yet, run buien --home <place> first")
    try:
        name = input("Which place do you want the rain for by default? (e.g. Gent) ").strip()
    except EOFError:
        name = ""
    if not name:
        raise BuienError("no place given")
    return save_place(HOME, lookup(name))


def resolve_place(options):
    """The place to show, saved first with --home or --save; None when a search ends without a pick."""
    if options.save or options.home:
        name, words = save_target(options)
        place = lookup(" ".join(words), choose=options.search)
        return place and save_place(name, place)
    text = " ".join(options.words)
    if options.search:
        if not text:
            raise BuienError("say what to search for, e.g. buien --search bergen")
        return lookup(text, choose=True)
    if text:
        return load_places().get(text.lower()) or lookup(text)
    return load_places().get(HOME) or ask_home()


def save_target(options):
    """The name to save under and the words of the place, for --home and --save."""
    if options.save:
        if len(options.words) < 2:
            raise BuienError("say a name and a place, e.g. buien --save work brussel")
        return options.words[0], options.words[1:]
    if not options.words:
        raise BuienError("say which place is home, e.g. buien --home gent")
    return HOME, options.words


def warn(message):
    print(f"buien: {message}", file=sys.stderr)


def fetch_forecast(place, now, fresh=False, warn=warn):
    """From the cache while it is fresh, else from Buienradar, and from the cache again when Buienradar is unreachable."""
    cached = read_cache(place)
    if cached and not fresh and timedelta(0) <= now - cached.fetched < CACHE_FRESH:
        ahead = slots_ahead(cached.slots, now)
        if ahead:
            return ahead
    try:
        data = fetch_json(FORECAST_URL.format(lat=place.lat, lon=place.lon))
    except BuienError as error:
        return fall_back(cached, now, error, warn)
    if data is None:
        raise BuienError(f"Buienradar has no radar for {place.name}, only for the Netherlands, Belgium and the border regions")
    slots = parse_forecast(data, now)
    write_cache(place, now, data, warn)
    return slots


def fall_back(cached, now, error, warn):
    """The cached forecast when Buienradar cannot be reached, as long as some of it lies ahead."""
    ahead = slots_ahead(cached.slots, now) if cached else []
    if not ahead:
        raise error
    warn(f"{error}, showing the forecast from {clock(cached.fetched.astimezone())}")
    return ahead


def cache_file(place):
    return user_dir("XDG_CACHE_HOME", ".cache") / f"{place.lat:.2f},{place.lon:.2f}.json"


def read_cache(place):
    """The last forecast fetched for this place; an unreadable cache counts as none and the next fetch rewrites it."""
    path = cache_file(place)
    if not path.exists():
        return None
    try:
        cached = json.loads(path.read_text(encoding="utf-8"))
        fetched = datetime.fromisoformat(cached["fetched"])
        if fetched.tzinfo is None:
            return None
        return Cached(fetched, parse_slots(cached["data"]))
    except (OSError, ValueError, KeyError, TypeError, BuienError):
        return None


def write_cache(place, now, data, warn):
    path = cache_file(place)
    try:
        write_atomic(path, json.dumps({"fetched": now.isoformat(), "data": data}))
        prune_cache(path.parent, now)
    except OSError as error:
        warn(f"could not cache the forecast ({error})")


def prune_cache(folder, now):
    """Removes cached forecasts that no longer reach past now."""
    oldest = (now - CACHE_KEEP).timestamp()
    for path in folder.glob("*.json"):
        with contextlib.suppress(FileNotFoundError):  # another buien may be pruning too
            if path.stat().st_mtime < oldest:
                path.unlink()


def parse_forecast(data, now):
    """The 5-minute slots from the one running at now on, in local time."""
    ahead = slots_ahead(parse_slots(data), now)
    if not ahead:
        raise BuienError("Buienradar's forecast is out of date, try again in a moment")
    return ahead


def parse_slots(data):
    try:
        return [Slot(utc_to_local(f["utcdatetime"]), float(f["precipitation"])) for f in data["forecasts"]]
    except (KeyError, TypeError, ValueError) as error:
        raise BuienError(f"Buienradar sent an unexpected answer ({error!r})") from error


def slots_ahead(slots, now):
    return [slot for slot in slots if slot.time + STEP > now]


def utc_to_local(text):
    return datetime.fromisoformat(text).replace(tzinfo=timezone.utc).astimezone()


def kind_of(mm):
    return next(kind for kind in KINDS if mm < kind.limit)


def spell_kind(slots):
    """'light rain', or a range such as 'light to heavy rain'."""
    rainy = [slot.mm for slot in slots if slot.mm > 0]
    lightest, heaviest = kind_of(min(rainy)), kind_of(max(rainy))
    if lightest.adjective == heaviest.adjective:
        return heaviest.name
    return f"{lightest.adjective} to {heaviest.adjective} rain"


def rain_spells(slots):
    """[start, end) index pairs of rain; a dry gap of one slot does not end a spell."""
    spells = []
    for index, slot in enumerate(slots):
        if slot.mm <= 0:
            continue
        if spells and index - spells[-1][1] <= SHORT_GAP:
            spells[-1][1] = index + 1
        else:
            spells.append([index, index + 1])
    return spells


def summarize(slots):
    spells = rain_spells(slots)
    horizon = clock(slots[-1].time + STEP)
    if not spells:
        return f"dry until at least {horizon}"
    text = describe_spell(slots, spells[0], horizon)
    if len(spells) > 1:
        start, end = spells[1]
        text += f", more {spell_kind(slots[start:end])} around {clock(slots[start].time)}"
    return text


def describe_spell(slots, spell, horizon):
    start, end = spell
    kind = spell_kind(slots[start:end])
    lasts_past_horizon = end == len(slots)
    if start == 0 and lasts_past_horizon:
        return f"{kind} now, not dry before {horizon}"
    if start == 0:
        return f"{kind} now, dry from {clock(slots[end].time)}"
    dry_until = clock(slots[start].time)
    if lasts_past_horizon:
        return f"dry until {dry_until}, then {kind}"
    return f"dry until {dry_until}, then {duration((end - start) * 5)} of {kind}"


def plan_trip(slots, now, minutes):
    """The first moment to leave and stay dry for minutes, and the last moment to leave in that same dry spell."""
    length = timedelta(minutes=minutes)
    horizon = slots[-1].time + STEP
    if now + length > horizon:
        reach = int((horizon - now).total_seconds() // 60)
        raise BuienError(f"the forecast reaches only until {clock(horizon)}, so a trip can take at most {reach} minutes")
    for start in [now] + [slot.time for slot in slots if slot.time > now]:
        if start + length > horizon:
            break
        if all(slot.mm <= 0 for slot in slots_during(slots, start, start + length)):
            rain = next((slot.time for slot in slots if slot.time >= start and slot.mm > 0), None)
            return Trip(minutes, start, rain and rain - length, start == now)
    return Trip(minutes, None, None, False)


def slots_during(slots, start, end):
    return [slot for slot in slots if slot.time < end and slot.time + STEP > start]


def describe_trip(trip, slots):
    span = duration(trip.minutes)
    if trip.earliest is None:
        return f"no dry {span} before {clock(slots[-1].time + STEP)}"
    first = clock(trip.earliest)
    if trip.latest is None:
        if trip.leave_now:
            return "leave whenever you like, no rain in sight"
        return f"leave from {first} to stay dry for {span}"
    last = clock(trip.latest)
    if trip.leave_now:
        return f"leave now to stay dry for {span}" if last == first else f"leave by {last} to stay dry for {span}"
    if first == last:
        return f"leave at {first} to stay dry for {span}"
    return f"leave between {first} and {last} to stay dry for {span}"


def peak(slots):
    """'heaviest at 13:25: 2.4 mm per hour', or None when it stays dry."""
    top = max(slots, key=lambda slot: slot.mm)
    if top.mm <= 0:
        return None
    return f"heaviest at {clock(top.time)}: {top.mm:.1f} mm per hour"


def clock(moment):
    return moment.strftime("%H:%M")


def duration(minutes):
    if minutes < 60:
        return f"{minutes} min"
    hours, rest = divmod(minutes, 60)
    if rest:
        return f"{hours}h{rest:02d}"
    return f"{hours} hour" if hours == 1 else f"{hours} hours"


class Paint:
    def __init__(self, enabled):
        self.enabled = enabled

    def wrap(self, text, code):
        return f"\033[{code}m{text}\033[0m" if self.enabled and text else text

    def bold(self, text):
        return self.wrap(text, "1")

    def dim(self, text):
        return self.wrap(text, "2")

    def color(self, text, color):
        return self.wrap(text, f"38;5;{color}")


def visible_len(text):
    return len(ANSI.sub("", text))


def bar_level(mm):
    """Eighths of a row on a log scale: 0.1 mm per hour is the floor, 10 fills the chart."""
    if mm <= 0:
        return 0
    height = (math.log10(mm) + 1) / 2
    return max(1, min(ROWS * 8, round(height * ROWS * 8)))


def chart_rows(slots, cell, paint):
    levels = [bar_level(slot.mm) for slot in slots]
    rows = []
    for row in reversed(range(ROWS)):
        cells = []
        for slot, level in zip(slots, levels):
            fill = min(8, max(0, level - row * 8))
            cells.append(paint.color(BLOCKS[fill] * cell, kind_of(slot.mm).color) if fill else " " * cell)
        rows.append("".join(cells).rstrip())
    dry = "no rain in sight"
    if not any(levels) and len(dry) <= len(slots) * cell:
        rows[ROWS // 2] = paint.dim(dry.center(len(slots) * cell).rstrip())
    return rows


def axis(slots, cell, window=range(0)):
    """The time axis with a tick every half hour; the slots in window drawn heavy."""
    line = ""
    for index, slot in enumerate(slots):
        tick, rule = ("┯", "━") if index in window else ("┬", "─")
        line += (tick if slot.time.minute % 30 == 0 else rule) + rule * (cell - 1)
    return line


def trip_window(slots, trip):
    """The indices of the dry stretch to travel in, from the earliest departure until the rain comes back."""
    if trip is None or trip.earliest is None:
        return range(0)
    end = trip.latest + timedelta(minutes=trip.minutes) if trip.latest else slots[-1].time + STEP
    spanned = [index for index, slot in enumerate(slots) if slot.time < end and slot.time + STEP > trip.earliest]
    return range(spanned[0], spanned[-1] + 1)


def axis_line(slots, cell, paint, trip):
    window = trip_window(slots, trip)
    line = axis(slots, cell, window)
    start, end = window.start * cell, window.stop * cell
    return paint.dim(line[:start]) + paint.color(line[start:end], TRIP_COLOR) + paint.dim(line[end:])


def time_labels(slots, cell):
    every = 30 if cell >= 2 else 60
    line = "now"
    for index, slot in enumerate(slots):
        column = index * cell
        if index == 0 or slot.time.minute % every or column <= len(line):
            continue
        line = line.ljust(column) + clock(slot.time)
    return line


def legend(slots, paint):
    return kinds_legend({kind_of(slot.mm) for slot in slots if slot.mm > 0}, paint)


def kinds_legend(present, paint):
    return "  ".join(f"{kind.label} {paint.color('█', kind.color)}" for kind in KINDS if kind in present)


def describe_slot(slot):
    if slot.mm <= 0:
        return "dry"
    return f"{kind_of(slot.mm).name}, {slot.mm:.1f} mm per hour"


def cursor_line(slots, cell, index, paint, room):
    """A marker under the slot at index with its time and rain after it, or before it when room runs out first."""
    slot = slots[index]
    detail = f"{clock(slot.time)}  {describe_slot(slot)}"
    column = index * cell
    if column + 2 + len(detail) > room and column > len(detail):
        return " " * (column - len(detail) - 1) + detail + " " + paint.bold("▲")
    return " " * column + paint.bold("▲") + " " + detail


def render(place, slots, now, color, width, trip=None, cursor=None):
    paint = Paint(color)
    cell = max(1, min(MAX_CELL, (width - 6) // len(slots)))
    title = f"{paint.bold(place.name)} {paint.dim('· ' + clock(now))}"
    key = legend(slots, paint)
    gap = max(2, len(slots) * cell - visible_len(title) - visible_len(key))
    lines = ["", f"  {title}{' ' * gap}{key}".rstrip(), ""]
    lines += [f"  {row}" for row in chart_rows(slots, cell, paint)]
    lines.append(f"  {axis_line(slots, cell, paint, trip)}")
    lines.append(f"  {paint.dim(time_labels(slots, cell))}")
    if cursor is not None:
        lines.append(f"  {cursor_line(slots, cell, cursor, paint, width - 2)}")
    lines += ["", f"  {paint.bold(summarize(slots))}"]
    if trip:
        advice = describe_trip(trip, slots)
        lines.append(f"  {paint.bold(paint.color(advice, TRIP_COLOR) if trip.earliest else advice)}")
    strongest = peak(slots)
    if strongest:
        lines.append(f"  {paint.dim(strongest)}")
    lines.append("")
    return "\n".join(lines)


def to_json(place, slots, trip=None):
    data = {
        "place": place.name,
        "lat": place.lat,
        "lon": place.lon,
        "summary": summarize(slots),
        "forecast": [{"time": slot.time.isoformat(timespec="minutes"), "mm_per_hour": slot.mm} for slot in slots],
    }
    if trip:
        data["trip"] = {
            "minutes": trip.minutes,
            "summary": describe_trip(trip, slots),
            "leave_now": trip.leave_now,
            "earliest": trip.earliest and trip.earliest.isoformat(timespec="minutes"),
            "latest": trip.latest and trip.latest.isoformat(timespec="minutes"),
        }
    return data


RADAR_URL = "https://image.buienradar.nl/2.0/metadata/sprite/RadarMapRainWebmercatorNL?"
RADAR_SIZE = (1058, 915)
RADAR_FRAMES = 12
RADAR_FRESH = timedelta(minutes=5)
RADAR_RETRY = timedelta(minutes=1)
RESIZE_WAIT = timedelta(seconds=1)
RADAR_DEPTHS = (0.3, 0.6, 0.85)
MAP_COLORS = {SEA: 235, LAND_DARK: 22, LAND_LIGHT: 28, BORDER: 100}
MAP_SHADES = {SEA: " ", LAND_DARK: ".", LAND_LIGHT: ".", BORDER: ":"}
RAIN_SHADES = "░░▒▓█"
MARK_COLOR, HERE_COLOR = 231, 226
MAP_HOLD = 3
Frame = namedtuple("Frame", "time rows")
Mark = namedtuple("Mark", "label place here")
Cell = namedtuple("Cell", "char fg bg")


def fetch_radar(width, height, forecast=RADAR_FRAMES):
    """Buienradar's rain radar of now and the forecast frames after it, ten minutes apart, at width x height pixels."""
    meta = fetch_json(RADAR_URL + urllib.parse.urlencode({"history": 1, "forecast": forecast, "skip": 1}))
    if meta is None:
        raise BuienError("Buienradar has no radar map right now, try again in a moment")
    try:
        times = [utc_to_local(entry["timestamp"]) for entry in meta["times"]]
        url = sized(meta["sprite"], width, height)
    except (KeyError, TypeError, ValueError) as error:
        raise BuienError(f"Buienradar sent an unexpected answer ({error!r})") from error
    data = fetch_bytes(url)
    if data is None:
        raise BuienError("Buienradar has no radar map right now, try again in a moment")
    picture = decode_png(data)
    count = min(len(times), picture.width // width)
    if picture.channels != 4 or picture.height != height or not count:
        raise BuienError("Buienradar sent a radar map of an unexpected size")
    stride = width * 4
    return [Frame(times[index], [row[index * stride:(index + 1) * stride] for row in picture.rows]) for index in range(count)]


def sized(url, width, height):
    """url asking for the rain alone, at width x height pixels."""
    parts = urllib.parse.urlsplit(url)
    query = dict(urllib.parse.parse_qsl(parts.query))
    query.update(width=width, height=height, renderBackground="False", renderBranding="False", renderText="False")
    return urllib.parse.urlunsplit(parts._replace(query=urllib.parse.urlencode(query)))


def map_size(columns, rows):
    """The largest radar map in pixels that fits columns x rows cells at two pixels a cell, in the radar's shape."""
    width = max(8, min(columns, MAP_MASK_SIZE[0]))
    height = width * RADAR_SIZE[1] // RADAR_SIZE[0]
    if height > rows * 2:
        height = max(4, rows * 2)
        width = height * RADAR_SIZE[0] // RADAR_SIZE[1]
    return width, height - height % 2


def radar_kind(red, green, blue, alpha):
    """The kind of rain a radar pixel shows on Buienradar's scale from pale blue through deep blue to purple and red."""
    if alpha < 100:
        return None
    if green < 30 and red > 40:
        return KINDS[-1]
    depth = (236 - red) / 231
    return KINDS[sum(depth >= limit for limit in RADAR_DEPTHS)]


def kinds_on(frame):
    return {kind for row in frame.rows for x in range(0, len(row), 4) for kind in [radar_kind(*row[x:x + 4])] if kind}


def map_pixel(frame, mask, x, y):
    """The kind of rain at a pixel, or else what the map has there: sea, land or a border."""
    return radar_kind(*frame.rows[y][x * 4:x * 4 + 4]) or mask[y][x]


def pixel_color(value):
    return value.color if isinstance(value, Kind) else MAP_COLORS[value]


def pixel_shade(value):
    return RAIN_SHADES[KINDS.index(value)] if isinstance(value, Kind) else MAP_SHADES[value]


def pixel_rank(value):
    return len(MAP_COLORS) + KINDS.index(value) if isinstance(value, Kind) else value


def map_cell(top, bottom, color):
    """A half block with a pixel in its upper and one in its lower half; without colour, the heavier of the two."""
    if color:
        return Cell("▀", pixel_color(top), pixel_color(bottom))
    return Cell(pixel_shade(max(top, bottom, key=pixel_rank)), None, None)


def map_lines(frame, mask, marks, paint):
    """The frame over the map in half blocks, with the places marked on top."""
    width, height = len(mask[0]), len(mask)
    rows = []
    for y in range(0, height - 1, 2):
        rows.append([map_cell(map_pixel(frame, mask, x, y), map_pixel(frame, mask, x, y + 1), paint.enabled) for x in range(width)])
    place_marks(rows, marks, width, height)
    return [join_cells(cells, paint) for cells in rows]


def place_marks(rows, marks, width, height):
    """A dot for every place, then labels, the place on screen first, each beside its dot where no other one is."""
    placed = []
    for mark in sorted(marks, key=lambda mark: not mark.here):
        position = map_position(mark.place, width, height)
        if position and position[1] // 2 < len(rows):
            x, row = position[0], position[1] // 2
            rows[row][x] = Cell("●", mark_color(mark), rows[row][x].bg)
            placed.append((mark, x, row))
    taken = {(row, x) for _, x, row in placed}
    for mark, x, row in placed:
        put_label(rows[row], row, mark, x, taken)


def put_label(cells, row, mark, x, taken):
    """The label after the dot, or before it when there is no room after it; left out when neither side is free."""
    text = f" {mark.label}"
    for start in (x + 1, x - len(text)):
        spots = [(row, column) for column in range(start, start + len(text))]
        if start >= 0 and start + len(text) <= len(cells) and not taken.intersection(spots):
            label = text if start > x else text[1:] + " "
            for (_, column), char in zip(spots, label):
                cells[column] = Cell(char, mark_color(mark), cells[column].bg)
            taken.update(spots)
            return


def mark_color(mark):
    return HERE_COLOR if mark.here else MARK_COLOR


def join_cells(cells, paint):
    if not paint.enabled:
        return "".join(cell.char for cell in cells).rstrip()
    runs = itertools.groupby(cells, key=lambda cell: (cell.fg, cell.bg))
    return "".join(f"\033[38;5;{fg};48;5;{bg}m" + "".join(cell.char for cell in run) for (fg, bg), run in runs) + "\033[0m"


def render_map(frame, now, marks, paint):
    """The title with the frame's time and the kinds of rain on it, then the map."""
    mask = map_mask(len(frame.rows[0]) // 4, len(frame.rows))
    minutes = round((frame.time - now).total_seconds() / 60)
    when = "now" if abs(minutes) < 5 else f"in {duration(minutes)}" if minutes > 0 else f"{duration(-minutes)} ago"
    title = f"{paint.bold('Radar')} {paint.dim(f'· {clock(frame.time)} · {when}')}"
    key = kinds_legend(kinds_on(frame), paint) or paint.dim("no rain on the radar")
    gap = max(2, len(mask[0]) - visible_len(title) - visible_len(key))
    lines = ["", f"  {title}{' ' * gap}{key}".rstrip(), ""]
    return lines + [f"  {line}" for line in map_lines(frame, mask, marks, paint)]


def saved_marks(here):
    """A mark for every saved place and one for here, under its saved name when it has one."""
    places = load_places()
    marks = [Mark(name, place, False) for name, place in places.items() if place != here]
    names = [name for name in home_first(places) if places[name] == here]
    return marks + [Mark(names[0] if names else here.name.split(",")[0], here, True)]


def live_layout(columns, lines):
    """The map beside the chart when the terminal is wide enough, else above it, or none at all when it is small."""
    room = columns - CHART_WIDTH - 4
    if room >= BESIDE_MIN_MAP and lines - BESIDE_RESERVED >= MIN_MAP_ROWS:
        return Layout(True, map_size(room, lines - BESIDE_RESERVED))
    if lines - MAP_RESERVED < MIN_MAP_ROWS:
        return Layout(False, None)
    return Layout(False, map_size(columns - 4, lines - MAP_RESERVED))


def chart_width(layout, columns):
    """What the chart has left: the whole width, or what the map leaves beside it."""
    return columns - layout.map_size[0] - 4 if layout.beside else columns


def compose(map_lines, chart_lines, layout, columns):
    """The map's lines beside the chart's, or centred above them."""
    if not map_lines:
        return chart_lines
    width = layout.map_size[0] + 2
    if not layout.beside:
        return [" " * max(0, (columns - width) // 2) + line for line in map_lines] + chart_lines
    rows = max(len(map_lines), len(chart_lines))
    lefts = [fit(line, width) for line in map_lines + [""] * (rows - len(map_lines))]
    rights = chart_lines + [""] * (rows - len(chart_lines))
    return [left + " " * (width - visible_len(left) + 2) + right for left, right in zip(lefts, rights)]


def snapshot_map(place, size, color):
    """The radar of now with your places on it, at size; nothing when Buienradar gives none."""
    try:
        frames = fetch_radar(*size, forecast=0)
    except BuienError as error:
        warn(f"no radar map ({error})")
        return []
    return render_map(frames[0], datetime.now().astimezone(), saved_marks(place), Paint(color))


def nearest(items, moment):
    """The index of the item whose time lies closest to moment."""
    return min(range(len(items)), key=lambda index: abs(items[index].time - moment))


LIVE_KEYS = "←→ time  space play  ↑↓ place  / search  s save  r refresh  q quit"
MAP_RESERVED = 21
BESIDE_RESERVED = 6
MIN_MAP_ROWS = 6
CHART_WIDTH = 78
BESIDE_MIN_MAP = 50
Layout = namedtuple("Layout", "beside map_size")
MENU_KEYS = "↑↓ choose  enter open  esc back"
LIVE_TICK = 0.5
ENTER_SCREEN = "\033[?1049h\033[?25l"
LEAVE_SCREEN = "\033[?25h\033[?1049l"
KEY_NAMES = {
    "\033[A": "up", "\033OA": "up", "\033[B": "down", "\033OB": "down",
    "\033[C": "right", "\033OC": "right", "\033[D": "left", "\033OD": "left",
    "\t": "tab", "\033[Z": "shift-tab", "\r": "enter", "\n": "enter",
    "\033": "esc", "\x7f": "backspace", "\x08": "backspace",
}
KEYS = re.compile(r"\033\[[0-9;]*[A-Za-z~]|\033O[A-Za-z]|\033[^\[O\033]|\033|.", re.DOTALL)
CUT_SEQUENCE = re.compile(rb"\033(\[[0-9;]*|O)?$")


def parse_keys(text):
    """Names such as 'left' or 'enter' for what the terminal sent; plain characters stay as they are."""
    return [KEY_NAMES.get(key, key) for key in KEYS.findall(text)]


def read_keys(fd):
    """The keys waiting on fd, with an escape sequence or character that the read cut in two completed first."""
    data = os.read(fd, 1024)
    while cut_short(data) and select.select([fd], [], [], 0.05)[0]:
        data += os.read(fd, 1024)
    return parse_keys(data.decode(errors="ignore"))


def cut_short(data):
    """True when data ends halfway an escape sequence or a UTF-8 character."""
    if CUT_SEQUENCE.search(data):
        return True
    try:
        data.decode()
    except UnicodeDecodeError as error:
        return error.end == len(data)
    return False


def fit(text, width):
    """text cut to width visible characters, its colour codes kept."""
    if visible_len(text) <= width:
        return text
    parts, room = [], width
    for part in re.split(f"({ANSI.pattern})", text):
        if ANSI.fullmatch(part):
            parts.append(part)
        else:
            parts.append(part[:room])
            room -= len(parts[-1])
    return "".join(parts) + "\033[0m"


@dataclass
class Tab:
    name: str
    place: Place

    @property
    def label(self):
        return self.name or self.place.name.split(",")[0]


@dataclass
class Loaded:
    """A tab's forecast as loaded at when: its slots or the error that kept them away, its trip, and a note."""
    when: datetime
    slots: object
    trip: Optional[Trip] = None
    note: str = ""


class Radar:
    """The radar frames the live screen plays: loaded for the terminal's size, and again every five minutes."""

    def __init__(self, fetch=None):
        self.fetch = fetch or fetch_radar
        self.frames = None
        self.error = None
        self.size = None
        self.loaded_at = None

    def due(self, now, size):
        return self.frames is None or self.size != size or not (self.loaded_at and timedelta(0) <= now - self.loaded_at < RADAR_FRESH)

    def load(self, now, size):
        """Loads the frames; when that fails, frames that still fit stay, and the next try is a minute away."""
        try:
            frames = self.fetch(*size)
        except BuienError as error:
            self.error = error
            if not (isinstance(self.frames, list) and self.size == size):
                self.frames = error
            self.loaded_at = now - RADAR_FRESH + RADAR_RETRY
        else:
            self.frames, self.error, self.loaded_at = frames, None, now
        self.size = size

    def note(self):
        """What to tell about a reload that failed while older frames stay on screen."""
        if self.error and isinstance(self.frames, list):
            return f"no new radar ({self.error}), showing the one from {clock(self.frames[0].time)}"
        return ""


@dataclass
class Prompt:
    label: str
    text: str = ""


class Live:
    """What buien --live shows: a tab per place, a cursor over the chart, and a prompt or a menu when asked."""

    def __init__(self, tabs, trip_minutes=None, fetch=None, search=None, radar=None):
        self.tabs = tabs
        self.index = 0
        self.trip_minutes = trip_minutes
        self.fetch = fetch or fetch_forecast
        self.search = search or matching_places
        self.cursor = 0
        self.loaded = {}
        self.fresh = False
        self.prompt = None
        self.menu = []
        self.choice = 0
        self.message = ""
        self.radar = radar or Radar()
        self.playing = True
        self.step = 0
        self.resized = None
        self.drawn = (None, [])

    @property
    def tab(self):
        return self.tabs[self.index]

    def update(self, now, size=None):
        """Loads one thing the screen needs, the forecast first, so it is drawn before the radar; True when it did."""
        if self.load_forecast(now):
            return True
        wanted = live_layout(size.columns, size.lines).map_size if size else None
        if not wanted:
            return False
        if not self.radar.due(now, wanted) or not self.settled(now, wanted):
            return False
        self.radar.load(now, wanted)
        return True

    def settled(self, now, wanted):
        """True when the radar has no frames yet, or the terminal has kept this new size for a moment."""
        if not isinstance(self.radar.frames, list) or self.radar.size == wanted:
            return True
        if self.resized is None or self.resized[0] != wanted:
            self.resized = (wanted, now)
        return now - self.resized[1] >= RESIZE_WAIT

    def load_forecast(self, now):
        """Loads the forecast of the tab on screen once a minute, or right away after r; True when it did."""
        loaded = self.loaded.get(self.index)
        if loaded and not self.fresh and clock(loaded.when) == clock(now):
            return False
        notes = []
        try:
            slots = self.fetch(self.tab.place, now, fresh=self.fresh, warn=notes.append)
        except BuienError as error:
            self.loaded[self.index] = Loaded(now, error)
        else:
            trip = self.plan_trip(slots, now, notes)
            self.loaded[self.index] = Loaded(now, slots, trip, "; ".join(notes))
            self.cursor = min(self.cursor, len(slots) - 1)
        self.fresh = False
        return True

    def plan_trip(self, slots, now, notes):
        """The trip, if one was asked for; a trip the forecast cannot hold becomes a note, the chart stays."""
        if not self.trip_minutes:
            return None
        try:
            return plan_trip(slots, now, self.trip_minutes)
        except BuienError as error:
            notes.append(str(error))
            return None

    def open(self, place):
        """Shows place, in a tab of its own when it has none yet."""
        for index, tab in enumerate(self.tabs):
            if tab.place == place:
                self.index = index
                break
        else:
            self.tabs.append(Tab("", place))
            self.index = len(self.tabs) - 1
        self.cursor = 0

    def key(self, key):
        """Handles one key; False when it asks to quit."""
        self.message = ""
        if self.prompt:
            self.prompt_key(key)
        elif self.menu:
            self.menu_key(key)
        elif key in ("q", "esc"):
            return False
        else:
            self.view_key(key)
        return True

    def view_key(self, key):
        """A key on the map and the chart."""
        if key in ("left", "right"):
            self.playing = False
            self.move_cursor(-1 if key == "left" else 1)
        elif key == " ":
            self.toggle_play()
        elif key in ("up", "down", "tab", "shift-tab"):
            self.index = (self.index + (-1 if key in ("up", "shift-tab") else 1)) % len(self.tabs)
            self.cursor = 0
        elif key == "r":
            self.loaded.pop(self.index, None)
            self.radar.loaded_at = None
            self.fresh = True
        elif key == "/":
            self.prompt = Prompt("search")
        elif key == "s":
            self.ask_name()

    def toggle_play(self):
        """Pauses the map, or plays it on from the frame on screen."""
        if isinstance(self.radar.frames, list):
            self.step = self.frame_index()
        self.playing = not self.playing

    def tick(self):
        """Half a second without keys: while playing, the map shows its next frame and the cursor follows it."""
        frames = self.radar.frames
        if not self.playing or not isinstance(frames, list):
            return
        self.step += 1
        slots = self.slots()
        if slots:
            self.cursor = nearest(slots, frames[self.frame_index()].time)

    def frame_index(self):
        """While playing each frame in turn with the last held a moment, paused the one at the cursor's time."""
        frames, slots = self.radar.frames, self.slots()
        if self.playing or not slots:
            return min(self.step % (len(frames) + MAP_HOLD), len(frames) - 1)
        return nearest(frames, slots[min(self.cursor, len(slots) - 1)].time)

    def slots(self):
        loaded = self.loaded.get(self.index)
        return loaded.slots if loaded and isinstance(loaded.slots, list) else []

    def move_cursor(self, step):
        loaded = self.loaded.get(self.index)
        if loaded and isinstance(loaded.slots, list):
            self.cursor = max(0, min(len(loaded.slots) - 1, self.cursor + step))

    def prompt_key(self, key):
        if key == "esc":
            self.prompt = None
        elif key == "backspace":
            self.prompt.text = self.prompt.text[:-1]
        elif key == "enter":
            prompt, self.prompt = self.prompt, None
            self.submit(prompt)
        elif len(key) == 1 and key.isprintable():
            self.prompt.text += key

    def submit(self, prompt):
        text = prompt.text.strip()
        if not text:
            return
        try:
            if prompt.label == "save as":
                self.save(text)
                return
            found = self.search(text)
        except (BuienError, OSError) as error:
            self.message = str(error)
            return
        if len(found) == 1:
            self.open(found[0])
        else:
            self.menu, self.choice = found, 0

    def menu_key(self, key):
        if key == "esc":
            self.menu = []
        elif key in ("up", "down"):
            self.choice = (self.choice + (1 if key == "down" else -1)) % len(self.menu)
        elif key == "enter":
            place, self.menu = self.menu[self.choice], []
            self.open(place)

    def ask_name(self):
        if self.tab.name:
            self.message = f"{self.tab.place.name} is saved as {self.tab.name}"
        else:
            self.prompt = Prompt("save as")

    def save(self, name):
        self.message = remember_place(name, self.tab.place)
        for tab in self.tabs:
            if tab.name == name.lower():
                tab.name = ""
        self.tab.name = name.lower()

    def screen(self, now, width, height, color):
        """Every line of the terminal, each cut to its width, with a note and the keys at the bottom."""
        paint = Paint(color)
        loaded = self.loaded.get(self.index)
        note = self.message or "; ".join(filter(None, [loaded.note if loaded else "", self.radar.note()]))
        bottom = [f" {note}", self.bottom_line(paint)] if note else [self.bottom_line(paint)]
        if self.menu:
            body = self.menu_lines(paint)
        else:
            layout = live_layout(width, height)
            chart = self.chart_lines(now, chart_width(layout, width) if layout.map_size else width, paint)
            room = height - len(bottom) - 1 - (0 if layout.beside else len(chart))
            body = compose(self.map_lines(now, paint, room) if layout.map_size else [], chart, layout, width)
        lines = ([self.tab_line(paint)] + body)[:max(0, height - len(bottom))]
        lines += [""] * (height - len(bottom) - len(lines)) + bottom
        return [fit(line, width) for line in lines[-height:]]

    def tab_line(self, paint):
        labels = []
        for index, tab in enumerate(self.tabs):
            if index != self.index:
                labels.append(paint.dim(f" {tab.label} "))
            elif paint.enabled:
                labels.append(paint.wrap(f" {tab.label} ", "7"))
            else:
                labels.append(f"[{tab.label}]")
        return " " + "".join(labels)

    def chart_lines(self, now, width, paint):
        loaded = self.loaded.get(self.index)
        if loaded is None:
            return ["", f"  {paint.dim('fetching the forecast')}"]
        if isinstance(loaded.slots, BuienError):
            return ["", f"  {paint.bold(self.tab.place.name)}", "", f"  {loaded.slots}"]
        cursor = min(self.cursor, len(loaded.slots) - 1)
        return render(self.tab.place, loaded.slots, now, paint.enabled, width, loaded.trip, cursor).split("\n")

    def map_lines(self, now, paint, room):
        """The radar frame on screen with every tab's place on it, in the room the chart leaves."""
        frames = self.radar.frames
        if room < MIN_MAP_ROWS + 3:
            return []
        if frames is None:
            return ["", f"  {paint.dim('fetching the radar')}"]
        if isinstance(frames, BuienError):
            return ["", f"  {paint.bold('Radar')} {paint.dim(str(frames))}"]
        index = self.frame_index()
        marks = tuple(Mark(tab.label, tab.place, number == self.index) for number, tab in enumerate(self.tabs))
        key = (id(frames), index, marks, paint.enabled, clock(now))
        if self.drawn[0] != key:
            self.drawn = (key, render_map(frames[index], now, marks, paint))
        return self.drawn[1][:room]

    def menu_lines(self, paint):
        lines = ["", f"  {paint.bold('Which one?')}", ""]
        for index, place in enumerate(self.menu):
            lines.append(f"  {paint.bold('> ' + place.name)}" if index == self.choice else f"    {place.name}")
        return lines

    def bottom_line(self, paint):
        if self.prompt:
            return f" {self.prompt.label}: {self.prompt.text}█"
        return paint.dim(f" {MENU_KEYS if self.menu else LIVE_KEYS}")


def live_mode(options):
    """buien --live: the chart full screen and kept up to date, a tab for every saved place."""
    if options.short or options.as_json:
        raise BuienError("--live shows the chart, so it goes without --short and --json")
    if termios is None:
        raise BuienError("--live needs a Unix terminal, such as on macOS or Linux")
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        raise BuienError("--live needs a terminal")
    place = resolve_place(options)
    if place is None:
        return 0
    places = load_places()
    live = Live([Tab(name, places[name]) for name in home_first(places)], options.trip)
    live.open(place)
    run_live(live, use_color(options))
    return 0


class Terminal:
    """The terminal as --live uses it: the alternate screen in cbreak mode, handed back on the way out or on ctrl-z."""

    def __init__(self, fd):
        self.fd = fd
        self.saved = termios.tcgetattr(fd)
        self.shown = None

    def enter(self):
        tty.setcbreak(self.fd)
        sys.stdout.write(ENTER_SCREEN)
        sys.stdout.flush()
        self.shown = None

    def leave(self):
        termios.tcsetattr(self.fd, termios.TCSADRAIN, self.saved)
        sys.stdout.write(LEAVE_SCREEN)
        sys.stdout.flush()

    def draw(self, lines):
        frame = "\n".join(lines)
        if frame != self.shown:
            sys.stdout.write("\033[H" + frame.replace("\n", "\033[K\n") + "\033[K\033[J")
            sys.stdout.flush()
            self.shown = frame

    def suspend(self, signum, frame):
        """ctrl-z: hands the terminal back as it was, stops, and takes it again on fg."""
        self.leave()
        signal.signal(signal.SIGTSTP, signal.SIG_DFL)
        os.kill(os.getpid(), signal.SIGTSTP)
        signal.signal(signal.SIGTSTP, self.suspend)
        self.enter()


def run_live(live, color):
    terminal = Terminal(sys.stdin.fileno())
    previous = {signum: signal.getsignal(signum) for signum in (signal.SIGTSTP, signal.SIGTERM)}
    signal.signal(signal.SIGTSTP, terminal.suspend)
    signal.signal(signal.SIGTERM, lambda signum, frame: sys.exit(128 + signum))
    try:
        terminal.enter()
        live_loop(live, terminal, color)
    finally:
        terminal.leave()
        for signum, handler in previous.items():
            signal.signal(signum, handler)


def live_loop(live, terminal, color):
    """Draws, loads and handles keys until a key asks to quit; the screen is drawn before a slow load starts."""
    while True:
        now = datetime.now().astimezone()
        size = shutil.get_terminal_size()
        terminal.draw(live.screen(now, size.columns, size.lines, color))
        if live.update(now, size):
            continue
        if not select.select([terminal.fd], [], [], LIVE_TICK)[0]:
            live.tick()
            continue
        for key in read_keys(terminal.fd):
            if not live.key(key):
                return


def completion_script(shell):
    """The script that teaches a shell buien's options and your saved places."""
    scripts = {"bash": bash_completion, "fish": fish_completion, "zsh": zsh_completion}
    if shell not in scripts:
        raise BuienError(f"say which shell to complete for: {', '.join(SHELLS)}")
    return scripts[shell]()


def zsh_completion():
    specs = []
    for flag in FLAGS:
        for name in filter(None, (flag.short, flag.long)):
            specs.append(f"    '{name}[{flag.about}]{zsh_value(flag)}' \\")
    return "\n".join([
        "#compdef buien",
        "_buien() {",
        "  local -a places",
        '  places=(${(f)"$(buien --places --short 2>/dev/null)"})',
        "  _arguments \\",
        *specs,
        "    '*:place:compadd -a places'",
        "}",
        'if [[ "$funcstack[1]" == _buien ]]; then _buien "$@"; else compdef _buien buien; fi',
    ])


def zsh_value(flag):
    """What zsh offers after a flag that takes a value: its choices, or only the value's name."""
    if flag.choices:
        return f":{flag.value}:({' '.join(flag.choices)})"
    return f":{flag.value}: " if flag.value else ""


def bash_completion():
    names = " ".join(name for flag in FLAGS for name in (flag.short, flag.long) if name)
    arms = []
    for flag in FLAGS:
        if flag.value:
            choices = " ".join(flag.choices)
            arms.append(f'    {flag.long}) COMPREPLY=($(compgen -W "{choices}" -- "$cur")); return ;;')
    return "\n".join([
        "_buien() {",
        '  local cur="${COMP_WORDS[COMP_CWORD]}"',
        '  case "${COMP_WORDS[COMP_CWORD-1]}" in',
        *arms,
        "  esac",
        '  if [[ "$cur" == -* ]]; then',
        f'    COMPREPLY=($(compgen -W "{names}" -- "$cur"))',
        "  else",
        "    local IFS=$'\\n'",
        '    COMPREPLY=($(compgen -W "$(buien --places --short 2>/dev/null)" -- "$cur"))',
        "  fi",
        "}",
        "complete -F _buien buien",
    ])


def fish_completion():
    lines = ["complete -c buien -f"]
    for flag in FLAGS:
        short = f" -s {flag.short[1:]}" if flag.short else ""
        arguments = f" -x -a '{' '.join(flag.choices)}'" if flag.choices else " -x" if flag.value else ""
        lines.append(f"complete -c buien{short} -l {flag.long[2:]}{arguments} -d '{flag.about}'")
    lines.append("complete -c buien -a '(buien --places --short 2>/dev/null)' -d 'saved place'")
    return "\n".join(lines)


def use_color(options):
    """--color or --no-color first, then NO_COLOR, then FORCE_COLOR, else only in a terminal."""
    if options.color is not None:
        return options.color
    if os.environ.get("NO_COLOR"):
        return False
    return bool(os.environ.get("FORCE_COLOR")) or sys.stdout.isatty()


def parse_args(argv):
    options = Options()
    args = iter(argv)
    for arg in args:
        if arg in ("-h", "--help"):
            options.help = True
        elif arg == "--version":
            options.version = True
        elif arg == "--home":
            options.home = True
        elif arg == "--save":
            options.save = True
        elif arg == "--search":
            options.search = True
        elif arg == "--forget":
            options.forget = True
        elif arg == "--places":
            options.list_places = True
        elif arg in ("-s", "--short"):
            options.short = True
        elif arg == "--json":
            options.as_json = True
        elif arg in ("--color", "--no-color"):
            options.color = arg == "--color"
        elif arg == "--completions":
            options.completions = next(args, "")
        elif arg == "--trip":
            options.trip = parse_minutes(next(args, ""))
        elif arg == "--live":
            options.live = True
        elif arg == "--once":
            options.once = True
        elif arg.startswith("-") and not COORDS.match(arg):
            raise BuienError(f"unknown option {arg}, see buien -h")
        else:
            options.words.append(arg)
    return options


def parse_minutes(text):
    if not (text.isascii() and text.isdigit()) or not 0 < int(text) <= 9999:
        raise BuienError("say how many minutes the trip takes, e.g. buien --trip 25")
    return int(text)


def run(options):
    if options.help:
        print(__doc__.strip())
        return 0
    if options.version:
        print(f"buien {__version__}")
        return 0
    if options.completions is not None:
        print(completion_script(options.completions))
        return 0
    if options.list_places:
        print_places(names_only=options.short)
        return 0
    if options.forget:
        if not options.words:
            raise BuienError("say which place to forget, e.g. buien --forget work")
        forget_place(" ".join(options.words))
        return 0
    if wants_live(options):
        return live_mode(options)
    place = resolve_place(options)
    if place is None:
        return 0
    now = datetime.now().astimezone()
    slots = fetch_forecast(place, now)
    trip = plan_trip(slots, now, options.trip) if options.trip else None
    show(options, place, slots, now, trip)
    return 2 if trip and options.short and not trip.leave_now else 0


def wants_live(options):
    """--live, or plain buien in a terminal; --once, --short, --json and a pipe get text."""
    if options.live:
        return True
    if options.once or options.short or options.as_json:
        return False
    return termios is not None and sys.stdin.isatty() and sys.stdout.isatty()


def show(options, place, slots, now, trip):
    if options.as_json:
        print(json.dumps(to_json(place, slots, trip), ensure_ascii=False, indent=2))
    elif options.short:
        print(describe_trip(trip, slots) if trip else summarize(slots))
    else:
        size, color = shutil.get_terminal_size(), use_color(options)
        layout = live_layout(size.columns, size.lines) if sys.stdout.isatty() else Layout(False, None)
        columns = chart_width(layout, size.columns) if layout.map_size else size.columns
        chart = render(place, slots, now, color, columns, trip).split("\n")
        above = snapshot_map(place, layout.map_size, color) if layout.map_size else []
        print("\n".join(compose(above, chart, layout, size.columns)))


def main(argv=None):
    try:
        return run(parse_args(sys.argv[1:] if argv is None else argv))
    except BuienError as error:
        print(f"buien: {error}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print(file=sys.stderr)
        return 130


