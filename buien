#!/usr/bin/env python3
"""buien: the rain for the next few hours in your terminal, from Buienradar.

  buien               the rain at home for the next three hours
                      (the first time, buien asks where home is)
  buien gent          somewhere else
  buien sint niklaas  a place name may be several words
  buien 51.05,3.72    coordinates
  buien --home gent   save Gent as home and show it right away
  buien --short       only the summary, for a status bar or prompt
  buien --json        the forecast as JSON, for scripts

Home is kept in ~/.config/buien/home.json.
Works in the Netherlands, Belgium and the border regions, as far as
Buienradar's radar reaches. Colour is dropped with NO_COLOR or when the
output is not a terminal.
"""
import json
import math
import os
import re
import shutil
import sys
import urllib.error
import urllib.parse
import urllib.request
from collections import namedtuple
from dataclasses import dataclass, field
from datetime import datetime, timedelta, timezone
from pathlib import Path

FORECAST_URL = "https://graphdata.buienradar.nl/2.0/forecast/geo/Rain3Hour?lat={lat:.2f}&lon={lon:.2f}"
GEOCODE_URL = "https://geocoding-api.open-meteo.com/v1/search?"
NEARBY_COUNTRIES = ("BE", "NL")
STEP = timedelta(minutes=5)
SHORT_GAP = 1
ROWS = 3
BLOCKS = " ▁▂▃▄▅▆▇█"
COORDS = re.compile(r"^\s*(-?\d+(?:\.\d+)?)\s*,\s*(-?\d+(?:\.\d+)?)\s*$")
ANSI = re.compile(r"\033\[[0-9;]*m")

Place = namedtuple("Place", "name lat lon")
Slot = namedtuple("Slot", "time mm")
Kind = namedtuple("Kind", "limit name label adjective color")

KINDS = [
    Kind(0.5, "wat druppels", "druppels", "lichte", 110),
    Kind(2, "lichte regen", "licht", "lichte", 74),
    Kind(5, "matige regen", "matig", "matige", 32),
    Kind(10, "stevige regen", "stevig", "stevige", 26),
    Kind(math.inf, "hevige regen", "hevig", "hevige", 162),
]


class BuienError(Exception):
    pass


@dataclass
class Options:
    words: list = field(default_factory=list)
    home: bool = False
    short: bool = False
    as_json: bool = False
    help: bool = False


def fetch_json(url):
    """The decoded JSON at url, or None when the server answers 404."""
    host = urllib.parse.urlsplit(url).hostname
    request = urllib.request.Request(url, headers={"User-Agent": "buien"})
    try:
        with urllib.request.urlopen(request, timeout=10) as response:
            return json.load(response)
    except urllib.error.HTTPError as error:
        if error.code == 404:
            return None
        raise BuienError(f"{host} antwoordt met HTTP {error.code}") from error
    except urllib.error.URLError as error:
        raise BuienError(f"{host} is niet bereikbaar ({error.reason})") from error
    except (OSError, ValueError) as error:
        raise BuienError(f"geen bruikbaar antwoord van {host} ({error})") from error


def lookup(text):
    match = COORDS.match(text)
    if match:
        lat, lon = float(match[1]), float(match[2])
        return Place(f"{lat:.2f}, {lon:.2f}", lat, lon)
    return geocode(text)


def geocode(name):
    results = search_places(name)
    if not results and " " in name:
        results = search_places(name.replace(" ", "-"))
    if not results:
        raise BuienError(f"geen plaats gevonden die '{name}' heet")
    best = next((r for r in results if r.get("country_code") in NEARBY_COUNTRIES), results[0])
    return Place(best["name"], best["latitude"], best["longitude"])


def search_places(name):
    query = urllib.parse.urlencode({"name": name, "count": 10, "language": "nl", "format": "json"})
    return (fetch_json(GEOCODE_URL + query) or {}).get("results") or []


def home_file():
    config = os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config"
    return Path(config) / "buien" / "home.json"


def load_home():
    path = home_file()
    if not path.exists():
        return None
    try:
        data = json.loads(path.read_text())
        return Place(data["name"], float(data["lat"]), float(data["lon"]))
    except (OSError, ValueError, KeyError, TypeError) as error:
        raise BuienError(f"{path} is unreadable ({error!r}), set home again with buien --home <place>") from error


def save_home(place):
    path = home_file()
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(place._asdict(), ensure_ascii=False) + "\n")
    print(f"{place.name} is now home, from now on plain buien is enough", file=sys.stderr)


def ask_home():
    if not sys.stdin.isatty():
        raise BuienError("no home saved yet, run buien --home <place> first")
    try:
        name = input("Which place do you want the rain for by default? (e.g. Gent) ").strip()
    except EOFError:
        name = ""
    if not name:
        raise BuienError("no place given")
    place = lookup(name)
    save_home(place)
    return place


def resolve_place(options):
    if options.words:
        place = lookup(" ".join(options.words))
        if options.home:
            save_home(place)
        return place
    if options.home:
        raise BuienError("say which place is home, e.g. buien --home gent")
    return load_home() or ask_home()


def fetch_forecast(place, now):
    data = fetch_json(FORECAST_URL.format(lat=place.lat, lon=place.lon))
    if data is None:
        raise BuienError(f"Buienradar heeft geen radar voor {place.name}, alleen voor Nederland, België en de grensstreek")
    return parse_forecast(data, now)


def parse_forecast(data, now):
    """The 5-minute slots from the one running at now on, in local time."""
    try:
        slots = [Slot(utc_to_local(f["utcdatetime"]), float(f["precipitation"])) for f in data["forecasts"]]
    except (KeyError, TypeError, ValueError) as error:
        raise BuienError(f"Buienradar stuurde een onverwacht antwoord ({error!r})") from error
    upcoming = [slot for slot in slots if slot.time + STEP > now]
    if not upcoming:
        raise BuienError("de verwachting van Buienradar is verouderd, probeer het zo opnieuw")
    return upcoming


def utc_to_local(text):
    return datetime.fromisoformat(text).replace(tzinfo=timezone.utc).astimezone()


def kind_of(mm):
    return next(kind for kind in KINDS if mm < kind.limit)


def spell_kind(slots):
    """'lichte regen', or a range such as 'lichte tot hevige regen'."""
    rainy = [slot.mm for slot in slots if slot.mm > 0]
    lightest, heaviest = kind_of(min(rainy)), kind_of(max(rainy))
    if lightest.adjective == heaviest.adjective:
        return heaviest.name
    return f"{lightest.adjective} tot {heaviest.adjective} regen"


def rain_spells(slots):
    """[start, end) index pairs of rain; a dry gap of one slot does not end a spell."""
    spells = []
    for index, slot in enumerate(slots):
        if slot.mm <= 0:
            continue
        if spells and index - spells[-1][1] <= SHORT_GAP:
            spells[-1][1] = index + 1
        else:
            spells.append([index, index + 1])
    return spells


def summarize(slots):
    spells = rain_spells(slots)
    horizon = clock(slots[-1].time + STEP)
    if not spells:
        return f"droog tot minstens {horizon}"
    text = describe_spell(slots, spells[0], horizon)
    if len(spells) > 1:
        start, end = spells[1]
        text += f", rond {clock(slots[start].time)} nog eens {spell_kind(slots[start:end])}"
    return text


def describe_spell(slots, spell, horizon):
    start, end = spell
    kind = spell_kind(slots[start:end])
    lasts_past_horizon = end == len(slots)
    if start == 0 and lasts_past_horizon:
        return f"nu {kind}, niet droog voor {horizon}"
    if start == 0:
        return f"nu {kind}, droog vanaf {clock(slots[end].time)}"
    dry_until = clock(slots[start].time)
    if lasts_past_horizon:
        return f"droog tot {dry_until}, daarna {kind}"
    return f"droog tot {dry_until}, dan {duration((end - start) * 5)} {kind}"


def peak(slots):
    """'het hardst om 13:25: 2,4 mm per uur', or None when it stays dry."""
    top = max(slots, key=lambda slot: slot.mm)
    if top.mm <= 0:
        return None
    amount = f"{top.mm:.1f}".replace(".", ",")
    return f"het hardst om {clock(top.time)}: {amount} mm per uur"


def clock(moment):
    return moment.strftime("%H:%M")


def duration(minutes):
    if minutes < 60:
        return f"{minutes} min"
    hours, rest = divmod(minutes, 60)
    return f"{hours} uur" if not rest else f"{hours}u{rest:02d}"


class Paint:
    def __init__(self, enabled):
        self.enabled = enabled

    def wrap(self, text, code):
        return f"\033[{code}m{text}\033[0m" if self.enabled and text else text

    def bold(self, text):
        return self.wrap(text, "1")

    def dim(self, text):
        return self.wrap(text, "2")

    def color(self, text, color):
        return self.wrap(text, f"38;5;{color}")


def visible_len(text):
    return len(ANSI.sub("", text))


def bar_level(mm):
    """Eighths of a row on a log scale: 0.1 mm per hour is the floor, 10 fills the chart."""
    if mm <= 0:
        return 0
    height = (math.log10(mm) + 1) / 2
    return max(1, min(ROWS * 8, round(height * ROWS * 8)))


def chart_rows(slots, cell, paint):
    levels = [bar_level(slot.mm) for slot in slots]
    rows = []
    for row in reversed(range(ROWS)):
        cells = []
        for slot, level in zip(slots, levels):
            fill = min(8, max(0, level - row * 8))
            cells.append(paint.color(BLOCKS[fill] * cell, kind_of(slot.mm).color) if fill else " " * cell)
        rows.append("".join(cells).rstrip())
    return rows


def axis(slots, cell):
    return "".join(("┬" if slot.time.minute % 30 == 0 else "─") + "─" * (cell - 1) for slot in slots)


def time_labels(slots, cell):
    every = 30 if cell == 2 else 60
    line = "nu"
    for index, slot in enumerate(slots):
        column = index * cell
        if index == 0 or slot.time.minute % every or column <= len(line):
            continue
        line = line.ljust(column) + clock(slot.time)
    return line


def legend(slots, paint):
    present = {kind_of(slot.mm) for slot in slots if slot.mm > 0}
    return "  ".join(f"{kind.label} {paint.color('█', kind.color)}" for kind in KINDS if kind in present)


def render(place, slots, now, color, width):
    paint = Paint(color)
    cell = 2 if 2 + 2 * len(slots) + 4 <= width else 1
    title = f"{paint.bold(place.name)} {paint.dim('· ' + clock(now))}"
    key = legend(slots, paint)
    gap = max(2, len(slots) * cell - visible_len(title) - visible_len(key))
    lines = ["", f"  {title}{' ' * gap}{key}".rstrip(), ""]
    lines += [f"  {row}" for row in chart_rows(slots, cell, paint)]
    lines.append(f"  {paint.dim(axis(slots, cell))}")
    lines.append(f"  {paint.dim(time_labels(slots, cell))}")
    lines += ["", f"  {paint.bold(summarize(slots))}"]
    strongest = peak(slots)
    if strongest:
        lines.append(f"  {paint.dim(strongest)}")
    lines.append("")
    return "\n".join(lines)


def to_json(place, slots):
    return {
        "place": place.name,
        "lat": place.lat,
        "lon": place.lon,
        "summary": summarize(slots),
        "forecast": [{"time": slot.time.isoformat(timespec="minutes"), "mm_per_hour": slot.mm} for slot in slots],
    }


def use_color():
    return sys.stdout.isatty() and not os.environ.get("NO_COLOR")


def parse_args(argv):
    options = Options()
    for arg in argv:
        if arg in ("-h", "--help"):
            options.help = True
        elif arg == "--home":
            options.home = True
        elif arg in ("-s", "--short"):
            options.short = True
        elif arg == "--json":
            options.as_json = True
        elif arg.startswith("-") and not COORDS.match(arg):
            raise BuienError(f"unknown option {arg}, see buien -h")
        else:
            options.words.append(arg)
    return options


def run(options):
    if options.help:
        print(__doc__.strip())
        return 0
    place = resolve_place(options)
    now = datetime.now().astimezone()
    slots = fetch_forecast(place, now)
    if options.as_json:
        print(json.dumps(to_json(place, slots), ensure_ascii=False, indent=2))
    elif options.short:
        print(summarize(slots))
    else:
        print(render(place, slots, now, use_color(), shutil.get_terminal_size().columns))
    return 0


def main(argv=None):
    try:
        return run(parse_args(sys.argv[1:] if argv is None else argv))
    except BuienError as error:
        print(f"buien: {error}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print(file=sys.stderr)
        return 130


if __name__ == "__main__":
    sys.exit(main())
